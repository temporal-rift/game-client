# Copy to .env.local for local development. Never commit real values.
VITE_API_BASE_URL=http://localhost:8080
# Auth0 tenant issuer both the game services and this client trust,
# e.g. https://YOUR_TENANT.eu.auth0.com/
VITE_OIDC_ISSUER_URL=https://YOUR_TENANT.eu.auth0.com/
VITE_OIDC_CLIENT_ID=game-client
# Auth0 API identifier the access tokens are minted for. The game services
# validate the issuer and signature; request the audience registered for
# the Temporal Rift API in the Auth0 dashboard.
VITE_OIDC_AUDIENCE=https://temporal-rift.example.com/api
