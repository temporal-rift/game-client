# Copy to .env.local for local development. Never commit real values.
VITE_API_BASE_URL=http://localhost:8080
# Any standards-compliant OIDC issuer both the game services and this client
# trust, e.g. an Auth0 tenant (https://YOUR_TENANT.eu.auth0.com/), Keycloak
# realm, or a self-hosted issuer. Discovered at runtime via the issuer's own
# .well-known/openid-configuration — no vendor-specific client code.
VITE_OIDC_ISSUER_URL=https://YOUR_TENANT.eu.auth0.com/
VITE_OIDC_CLIENT_ID=game-client
# API identifier the access tokens are minted for (passed through to the
# issuer's authorization request as the `audience` parameter, honored by
# providers that support one, e.g. Auth0). The game services validate the
# issuer and signature independently of this value.
VITE_OIDC_AUDIENCE=https://temporal-rift.example.com/api
