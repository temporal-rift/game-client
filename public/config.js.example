// Copy to public/config.js for local development (gitignored, never committed with real
// values). In production this file is generated by the serving container's entrypoint from
// environment variables at startup -- see docker/render-runtime-config.sh -- not hand-edited.
window.__APP_CONFIG__ = {
  apiBaseUrl: 'http://localhost:8080',
  // Any standards-compliant OIDC issuer both the game services and this client trust, e.g. an
  // Auth0 tenant (https://YOUR_TENANT.eu.auth0.com/), Keycloak realm, or a self-hosted issuer.
  // Discovered at runtime via the issuer's own .well-known/openid-configuration -- no
  // vendor-specific client code.
  oidcIssuerUrl: 'https://YOUR_TENANT.eu.auth0.com/',
  oidcClientId: 'game-client',
  // API identifier the access tokens are minted for (passed through to the issuer's
  // authorization request as the `audience` parameter, honored by providers that support one,
  // e.g. Auth0). The game services validate the issuer and signature independently of this
  // value.
  oidcAudience: 'https://temporal-rift.example.com/api',
}
